# Local development values. Never commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/agri_hub"
APP_URL="http://localhost:3100"
JWT_SECRET="change-me-to-a-long-random-string"

# Storage: "local" (dev emulator, signed PUT URLs into ./storage) or "s3" (AWS S3 / Cloudflare R2)
STORAGE_DRIVER="local"   # local | db | s3
S3_BUCKET_NAME=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Email: leave SENDGRID_API_KEY empty to only record emails in the admin Mailbox
SENDGRID_API_KEY=""
EMAIL_FROM="AGRI HUB <no-reply@griscanada.org>"

# QA only: multiplies every rate limit (keep 1 in production)
RATE_LIMIT_SCALE="1"

# Which proxy header carries the real client IP: vercel | x-real-ip | xff-last (unset = trust none)
TRUST_PROXY="vercel"
